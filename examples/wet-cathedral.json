{
  "name": "Wet Cathedral",
  "description": "Dark evolving pad with additive harmonics, cathedral reverb, and per-chord filter bloom",
  "type": "Pad",
  "subtype": "Evolving",
  "author": "Claude",

  "voice": { "mode": "Poly" },

  "osc1": {
    "engine": "Harmo",
    "wave": 0.4,
    "timbre": 0.70,
    "shape": 0.55,
    "volume": 0.85
  },

  "osc2": {
    "engine": "BasicWaves",
    "wave": 0.0,
    "timbre": 0.5,
    "shape": 0.65,
    "volume": 0.35,
    "tune": 0.0
  },

  "filter": {
    "mode": "LPF",
    "cutoff": 0.25,
    "resonance": 0.03,
    "env_amount": 0.60
  },

  "envelope": {
    "attack": 0.45,
    "decay": 0.5,
    "sustain": 0.85,
    "release": 0.65
  },

  "lfo1": { "rate": 0.06, "wave": "Triangle", "sync": false },
  "lfo2": { "rate": 0.04, "wave": "Sine", "sync": false },

  "cycling_env": { "rise": 0.60, "fall": 0.65, "hold": 0.1, "mode": "Loop" },

  "fx": [
    { "algo": "Chorus", "opt1": "Lush", "time": 0.35, "intensity": 0.5, "amount": 0.55 },
    { "algo": "Reverb", "opt1": "Long", "time": 0.75, "intensity": 0.35, "amount": 0.60 },
    { "algo": "Phaser", "opt1": "Space", "time": 0.15, "intensity": 0.3, "amount": 0.35 }
  ],

  "mod": [
    { "src": "CycEnv", "dest": "Cutoff", "amount": "+15%" },
    { "src": "CycEnv", "dest": "Osc1 Timbre", "amount": "+12%" },
    { "src": "LFO1", "dest": "Osc1 Wave", "amount": "+10%" },
    { "src": "LFO2", "dest": "FX1 Intensity", "amount": "+15%" },
    { "src": "LFO2", "dest": "FX3 Time", "amount": "+10%" },
    { "src": "Velocity", "dest": "Cutoff", "amount": "+20%" },
    { "src": "Envelope", "dest": "Osc1 Timbre", "amount": "+8%" },
    { "src": "Wheel", "dest": "Osc1 Timbre", "amount": "+40%" },
    { "src": "Kbd", "dest": "Cutoff", "amount": "+15%" }
