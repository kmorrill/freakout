      { "step": 6,  "notes": ["Ab2", "Eb3", "C4"], "vel": 55,  "gate": 0.8 },
      { "step": 7,  "notes": ["Ab2", "Eb3", "C4"], "vel": 50,  "gate": 0.7 },

