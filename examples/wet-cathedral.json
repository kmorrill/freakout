    "time_div": "1/4",
    "lane_dests": ["Cutoff"],
    "steps": [
      { "step": 0,  "notes": ["C3", "G3", "Eb4"], "vel": 90,  "gate": 0.95, "mods": [0.40] },
      { "step": 1,  "notes": ["C3", "G3", "Eb4"], "vel": 70,  "gate": 0.85 },
      { "step": 2,  "notes": ["C3", "G3", "Eb4"], "vel": 60,  "gate": 0.8 },
